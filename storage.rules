rules_version = '2';

service firebase.storage {
  // L'appartenance est vérifiée dans Firestore pour chaque accès aux photos familiales.
  match /b/{bucket}/o {
    function member(familleId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/familles/$(familleId)/membres/$(request.auth.uid))
        && (!firestore.get(/databases/(default)/documents/familles/$(familleId)/membres/$(request.auth.uid)).data.keys().hasAny(['bloqueParPlan'])
          || firestore.get(/databases/(default)/documents/familles/$(familleId)/membres/$(request.auth.uid)).data.bloqueParPlan != true);
    }

    match /familles/{familleId}/sorties/{userId}/{fileName} {
      allow read: if member(familleId);
      allow delete: if member(familleId);
      allow write: if member(familleId)
        && request.auth.uid == userId
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
