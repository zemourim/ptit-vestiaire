rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /vetements/{vetementId} {
      allow read, create, update, delete: if signedIn();
    }

    match /mouvements/{mouvementId} {
      allow read, create, update, delete: if signedIn();
    }

    // Ancienne collection, conservée en lecture le temps de valider la migration.
    match /sorties/{sortieId} {
      allow read, create, update, delete: if signedIn();
    }

    match /settings/{settingId} {
      allow read, write: if signedIn();
    }
  }
}
